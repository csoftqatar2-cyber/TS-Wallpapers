<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fsclockRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <systems.sieber.fsclock.WallpaperView
        android:id="@+id/wallpaperView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imageViewBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/linearLayoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/margin_main"
        android:gravity="center"
        android:orientation="vertical"
        android:divider="@drawable/divider_clock_vertical"
        android:showDividers="middle">

        <TextView
            android:id="@+id/textViewEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/events"
            android:textColor="@color/colorDefaultClock"
            android:textSize="25sp" />

        <GridLayout
            android:id="@+id/analogClockContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginLeft="@dimen/margin_clock"
            android:layout_marginRight="@dimen/margin_clock">

            <ImageView
                android:id="@+id/imageViewClockFace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/analog_classic_bg" />

            <ImageView
                android:id="@+id/imageViewClockHoursHand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/analog_classic_h" />

            <ImageView
                android:id="@+id/imageViewClockMinutesHand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/analog_classic_m" />

            <ImageView
                android:id="@+id/imageViewClockSecondsHand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/analog_classic_s" />
        </GridLayout>

        <LinearLayout
            android:id="@+id/digitalClockAndDateContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="fill_vertical"
            android:layout_weight="1"
            android:orientation="vertical">

            <systems.sieber.fsclock.DigitalClockView
                android:id="@+id/digitalClock"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="fill_vertical"
                android:gravity="bottom"
                android:layoutDirection="ltr"
                android:layout_weight="1"
                tools:ignore="NestedWeights" />

            <systems.sieber.fsclock.DateView
                android:id="@+id/textViewDate"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="fill_vertical"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/clock_prefilled"
                android:textAlignment="center"
                android:textColor="@color/colorDefaultClock"
                app:autoSizeMaxTextSize="800dp"
                app:autoSizeMinTextSize="20dp"
                app:autoSizeStepGranularity="1px"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/textViewHijriDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:visibility="gone"
                android:textColor="@color/colorDefaultClock"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutBottomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="0dp"
        android:showDividers="middle"
        android:divider="@drawable/divider_statusbar"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/linearLayoutWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:visibility="gone"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/textViewWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text=""
                android:textColor="@color/colorDefaultClock"
                android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/linearLayoutNotifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/imageViewNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="4dp"
                app:srcCompat="@drawable/ic_notifications_white_24dp" />
            <TextView
                android:id="@+id/textViewNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/colorDefaultClock"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutAlarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/imageViewAlarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="4dp"
                app:srcCompat="@drawable/ic_alarm_white_24dp" />
            <TextView
                android:id="@+id/textViewAlarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/clock_prefilled"
                android:textColor="@color/colorDefaultClock"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/imageViewBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_battery_full_white_24dp" />
            <TextView
                android:id="@+id/textViewBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/battery_prefilled"
                android:textColor="@color/colorDefaultClock"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
    <!-- Activation Overlay (shown only when the device is not activated in Supabase) -->
    <LinearLayout
        android:id="@+id/layoutActivation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f214100b"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- One centred card, split into two columns. Head-unit screens are wide and short
             (~2.67:1), so the old single 260dp column ran off the bottom: everything the user
             types is on the left, everything they choose is on the right, and neither column
             has to be tall. -->
        <LinearLayout
            android:id="@+id/layoutActivationCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/activation_card_bg"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Blocked. Its own banner above everything, because "blocked" and "not activated
                 yet" are opposite instructions: one says type a serial, the other says no serial
                 will ever work and only the shop can lift it. Showing the serial box to a blocked
                 car sends a technician back to the customer for a code that is guaranteed to be
                 refused. Hidden unless get_device_status says so.

                 Full width: applyBlockedState stretches the card across the screen while blocked,
                 so this reads as a bar over the whole page — the same shape the Store app uses
                 for the same message. -->
            <TextView
                android:id="@+id/textViewBlockedBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="18dp"
                android:background="@drawable/activation_blocked_bg"
                android:padding="18dp"
                android:text="@string/activation_error_blocked"
                android:textColor="@color/aurora_danger"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/layoutActivationColumns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Left: identify yourself and act. -->
                <LinearLayout
                    android:id="@+id/layoutActivationEntry"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/activation_overlay_title"
                        android:textColor="@color/gold"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/activation_overlay_subtitle"
                        android:textColor="@color/aurora_muted"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/editTextActivationSerial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/activation_input_bg"
                        android:textColor="@color/aurora_text"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:padding="12dp"
                        android:inputType="numberPassword"
                        android:hint="******"
                        android:textColorHint="@color/aurora_muted" />

                    <Button
                        android:id="@+id/buttonActivate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/activation_primary_btn"
                        android:textColor="#1a1204"
                        android:text="@string/activation_button"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/buttonRecheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/fit_secondary_btn"
                        android:textColor="@color/aurora_text"
                        android:text="@string/activation_recheck_button"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:padding="10dp" />

                    <TextView
                        android:id="@+id/textViewActivationStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/aurora_danger"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:id="@+id/viewActivationDivider"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/aurora_border" />

                <!-- Right: operating mode. Was a lone "FSE" checkbox with nothing explaining
                     what FSE is; Leopard could not simply be glued next to it, because the two
                     are exclusive and a second checkbox would let both be ticked with no
                     answer for what that means. -->
                <LinearLayout
                    android:id="@+id/layoutActivationMode"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_title"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/mode_exclusive_note"
                        android:textColor="@color/aurora_muted"
                        android:textSize="11sp" />

                    <RadioGroup
                        android:id="@+id/radioGroupActivationMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/radioActivationNormal"
                            style="@style/ActivationModeRadio"
                            android:checked="true"
                            android:text="@string/mode_normal" />

                        <RadioButton
                            android:id="@+id/radioActivationFse"
                            style="@style/ActivationModeRadio"
                            android:text="@string/mode_fse" />

                        <RadioButton
                            android:id="@+id/radioActivationLeopard"
                            style="@style/ActivationModeRadio"
                            android:text="@string/mode_leopard" />

                        <RadioButton
                            android:id="@+id/radioActivationGwm"
                            style="@style/ActivationModeRadio"
                            android:text="@string/mode_gwm" />

                        <!-- Same hand-off family as Leopard, and chosen here for the same
                             reason: the technician who fits the car is the only person who
                             knows which car it is, and every route to change it afterwards
                             costs somebody a phone call. -->
                        <RadioButton
                            android:id="@+id/radioActivationLynkco"
                            style="@style/ActivationModeRadio"
                            android:text="@string/mode_lynkco" />

                        <RadioButton
                            android:id="@+id/radioActivationJetour"
                            style="@style/ActivationModeRadio"
                            android:text="@string/mode_jetour" />

                    </RadioGroup>

                    <TextView
                        android:id="@+id/textViewActivationModeDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/aurora_muted"
                        android:textSize="11sp" />

                    <!-- The old checkbox stays, hidden: FsClockView and the settings screen
                         both still read it, and the radio above drives it. Removing it would
                         mean touching every read site in one go for no behavioural gain. -->
                    <CheckBox
                        android:id="@+id/checkBoxFse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:visibility="gone"
                        android:text="FSE" />
                </LinearLayout>

                <View
                    android:id="@+id/viewSupportDivider"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/aurora_border" />

                <!-- How to reach a human. The last column on BOTH screens, and the only one left
                     standing when the car is blocked — at that point it is the only thing on the
                     screen that can still change anything.
                     The QR carries the WhatsApp link because head units rarely have WhatsApp
                     installed (and often no browser at all): the customer scans it with their own
                     phone. The button below is for the few units that do. -->
                <LinearLayout
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/support_header"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/support_number"
                        android:textColor="@color/aurora_text"
                        android:textDirection="ltr"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imageViewSupportQr"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_marginTop="10dp"
                        android:background="@android:color/white"
                        android:contentDescription="@string/support_qr_hint"
                        android:padding="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/support_qr_hint"
                        android:textColor="@color/aurora_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Device ID: the one thing support asks for over the phone, so it stays on the
                 card, but quiet — it is read out, never acted on. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@drawable/chip_neutral_bg"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activation_device_id_label"
                    android:textColor="@color/aurora_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textViewActivationDeviceId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNKNOWN"
                    android:textColor="@color/aurora_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- "Downloading the wallpapers", Others mode only.

         Last child, so it covers everything: while the library is still coming down the
         slideshow has nothing local to show, and swiping through it fetches each picture over
         the car's link mid-gesture — which is what stuttering wallpapers under a finger
         actually are. Better to say plainly how far along it is and let it finish. It hides
         itself the moment the last file lands, and it never appears at all on a car whose
         library is already cached (the count reaches the total on the first tick). -->
    <LinearLayout
        android:id="@+id/layoutDownloadProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f2000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/download_progress_title"
            android:textColor="@color/aurora_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewDownloadPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="0%"
            android:textColor="@color/colorAccent"
            android:textSize="42sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBarDownload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/textViewDownloadCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/aurora_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/download_progress_hint"
            android:textColor="@color/aurora_muted"
            android:textSize="12sp" />

        <!-- An escape hatch, not a feature. Somebody standing in a workshop with a bad link
             still has to be able to get into the app. -->
        <Button
            android:id="@+id/buttonDownloadSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/download_progress_skip" />
    </LinearLayout>

</FrameLayout>
