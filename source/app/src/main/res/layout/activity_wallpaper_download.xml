<?xml version="1.0" encoding="utf-8"?>
<!-- Others/FSE only: a dedicated, opaque gate between the mode-confirm screen and the wallpaper
     screen. Nothing else is on this screen, so unlike an overlay drawn on top of FsClockView
     there is no stale cached wallpaper it could ever let show through underneath. It holds the
     car here until WallpaperRepo.sync() reports every file local (mediaReady) — see
     WallpaperDownloadActivity for the exact completion contract. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/download_progress_title"
        android:textColor="@color/aurora_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewWpDownloadPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="0%"
        android:textColor="@color/colorAccent"
        android:textSize="42sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressBarWpDownload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="240dp"
        android:layout_height="10dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/textViewWpDownloadCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/aurora_muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/download_progress_hint"
        android:textColor="@color/aurora_muted"
        android:textSize="12sp" />

</LinearLayout>
