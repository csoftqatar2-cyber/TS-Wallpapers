<?xml version="1.0" encoding="utf-8"?>
<!-- Every wallpaper-drawing mode passes through here: a dedicated, opaque gate between the
     mode-confirm screen and the wallpaper screen. Nothing else is on this screen, so unlike an
     overlay drawn on top of FsClockView there is no stale cached wallpaper it could ever let show
     through underneath. It holds the car here until WallpaperRepo.sync() reports every file local
     (mediaReady) — see WallpaperDownloadActivity for the exact completion contract.

     The bar runs on 0..1000, not 0..100: it is driven from a byte count and animated between
     ticks, and at 100 steps that motion quantises back into the jumps this screen exists to
     stop looking like. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/download_progress_title"
        android:textColor="@color/aurora_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewWpDownloadPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="0%"
        android:textColor="@color/colorAccent"
        android:textSize="46sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressBarWpDownload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="420dp"
        android:layout_height="12dp"
        android:layout_marginTop="12dp"
        android:max="1000"
        android:progress="0" />

    <!-- The two lines the workshop actually reads while it waits: how many wallpapers have
         landed, and whether the car's connection is moving at all. Big and gold on purpose —
         these are read from the driver's seat, at a distance, on a screen that is often
         washed out by daylight. -->
    <TextView
        android:id="@+id/textViewWpDownloadCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/gold"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewWpDownloadSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/download_progress_speed_waiting"
        android:textColor="@color/gold"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- How much longer. The count and the speed answer "is it moving"; neither answers the
         question actually being asked in the workshop, which is whether to stand and wait or go
         and do something else. Derived from elapsed time against progress rather than from byte
         sizes — see WallpaperDownloadActivity.etaText. -->
    <TextView
        android:id="@+id/textViewWpDownloadEta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/download_progress_eta_unknown"
        android:textColor="@color/gold"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/download_progress_hint"
        android:textColor="@color/aurora_muted"
        android:textSize="13sp" />

    <!-- The way out. The gate exists so a car does not swipe through a library it has not got,
         which is a real defect and worth waiting for — but on a slow workshop link the wait can
         run to many minutes, and holding a technician with a customer in the car has a cost of
         its own. This hands the choice over: the app opens on whatever has already landed and
         the same download carries on behind it. -->
    <Button
        android:id="@+id/buttonWpDownloadSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="48dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/download_progress_skip"
        android:textAllCaps="false"
        android:textSize="16sp" />

</LinearLayout>
