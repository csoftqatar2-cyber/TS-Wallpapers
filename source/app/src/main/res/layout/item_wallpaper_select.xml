<?xml version="1.0" encoding="utf-8"?>
<!-- One wallpaper in the manage grid.
     The cell IS the picture: you are choosing between images, so the image is the thing to make
     big. The two controls sit in the top corners, over a scrim so they stay readable on a white
     photo, and the name goes underneath where it can be ignored.

     Nothing here is `focusable`. A focusable child inside an AdapterView steals the row's click
     — which is exactly what broke the tick when this was a list with an "edit" button in it.
     Every tap target below is wired by the adapter instead.

     SIZING LIVES IN THE ADAPTER, not here. This used to be wrap_content + adjustViewBounds, which
     reads well and does not work: the cell is measured before Glide has delivered anything, so it
     settled at its minimum and the picture was then fitted into a box the wrong shape — the "the
     border is wider than the wallpaper inside it" complaint. The adapter now sets the cell's
     height from the picture's real proportions the moment they are known
     (WallpaperSelectAdapter.sizeCellToImage), and everything in here just fills that cell. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallpaperCell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#241c11">

    <ImageView
        android:id="@+id/imageViewWallpaperThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/wallpaper_manage_title" />

    <!-- top scrim: the corner controls sit on an arbitrary photo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:background="@drawable/wp_grid_scrim" />

    <CheckBox
        android:id="@+id/checkBoxWallpaperVisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:clickable="false"
        android:focusable="false" />

    <!-- Pencil, and — for images that live on this device only — a bin beside it. A cloud
         wallpaper has no bin on purpose: deleting it here would delete nothing (the next sync
         brings it straight back), so the honest controls for it are edit and the tick. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/buttonWallpaperDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:padding="7dp"
            android:visibility="gone"
            android:background="@drawable/wp_grid_edit_bg"
            android:src="@drawable/ic_delete_24dp"
            android:contentDescription="@string/wallpaper_delete" />

        <ImageView
            android:id="@+id/buttonWallpaperEdit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:background="@drawable/wp_grid_edit_bg"
            android:src="@drawable/ic_edit_20dp"
            android:contentDescription="@string/wallpaper_edit" />
    </LinearLayout>

    <TextView
        android:id="@+id/textViewWallpaperName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/aurora_text"
        android:textSize="11sp" />

    <!-- Last, so it is on top of the photo: the outline has to trace the edge of the picture,
         which it cannot do from underneath it. Mirrors the Leopard picker's cell. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:duplicateParentState="true"
        android:background="@drawable/wp_grid_cell_ring" />

</FrameLayout>
