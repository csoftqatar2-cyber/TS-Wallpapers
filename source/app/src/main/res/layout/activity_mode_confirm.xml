<?xml version="1.0" encoding="utf-8"?>
<!--
    The mode confirmation gate. Deliberately shaped like the activation overlay (same card,
    same gold/aurora palette) so a technician reads it as the same step of the same setup —
    but with the serial field replaced by a green "already activated" line, because the whole
    point is that activation is DONE and only the mode is missing.

    Head-unit screens are wide and short, so the card scrolls rather than clipping its button
    on the shortest panels.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f214100b"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/activation_card_bg"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/textViewModeConfirmActivated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_confirm_activated"
                android:textColor="#4caf50"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/mode_confirm_title"
                android:textColor="@color/gold"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/mode_confirm_subtitle"
                android:textColor="@color/aurora_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textViewModeConfirmDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/aurora_muted"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/radioGroupConfirmMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioConfirmNormal"
                    style="@style/ActivationModeRadio"
                    android:text="@string/mode_normal" />

                <RadioButton
                    android:id="@+id/radioConfirmFse"
                    style="@style/ActivationModeRadio"
                    android:text="@string/mode_fse" />

                <RadioButton
                    android:id="@+id/radioConfirmLeopard"
                    style="@style/ActivationModeRadio"
                    android:text="@string/mode_leopard" />

                <!-- Disabled-reason text lives in its own TextView rather than appended onto
                     the RadioButton's own label: on at least one head unit, a RadioButton whose
                     text was mutated to two lines at runtime rendered with its label clipped to
                     a sliver (bare circle, no visible text) instead of wrapping. A dedicated,
                     always-single-line RadioButton avoids that failure mode entirely. -->
                <TextView
                    android:id="@+id/textViewConfirmLeopardNote"
                    style="@style/ActivationModeRadio"
                    android:layout_marginTop="-4dp"
                    android:paddingTop="0dp"
                    android:paddingStart="4dp"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <RadioButton
                    android:id="@+id/radioConfirmGwm"
                    style="@style/ActivationModeRadio"
                    android:text="@string/mode_gwm" />

                <RadioButton
                    android:id="@+id/radioConfirmLynkco"
                    style="@style/ActivationModeRadio"
                    android:text="@string/mode_lynkco" />

                <TextView
                    android:id="@+id/textViewConfirmLynkcoNote"
                    style="@style/ActivationModeRadio"
                    android:layout_marginTop="-4dp"
                    android:paddingTop="0dp"
                    android:paddingStart="4dp"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <RadioButton
                    android:id="@+id/radioConfirmJetour"
                    style="@style/ActivationModeRadio"
                    android:text="@string/mode_jetour" />

            </RadioGroup>

            <TextView
                android:id="@+id/textViewModeConfirmDesc"
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/aurora_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonModeConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/activation_primary_btn"
                android:text="@string/mode_confirm_button"
                android:textColor="#1a1204"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- A car whose app is too old simply does not list the mode it is: Jetour did not
                 exist before 4.7, and a technician standing at such a car had no way forward from
                 this screen — the updater lives in Settings, and Settings is on the far side of a
                 gate that will not let anyone past without an answer. The car is already known to
                 be activated by the time this screen draws, so updating here costs nothing and is
                 the only way to make "update first, then pick the car" possible. -->
            <Button
                android:id="@+id/buttonModeConfirmUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/fit_secondary_btn"
                android:text="@string/update_check"
                android:textColor="@color/aurora_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textViewModeConfirmVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:textColor="@color/aurora_muted"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
