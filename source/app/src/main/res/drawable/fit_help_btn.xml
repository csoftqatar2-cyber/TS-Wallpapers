<?xml version="1.0" encoding="utf-8"?>
<!-- Help, on the fit editor.

     Green, and the only green thing on the screen. Everything else here is gold-on-black brand
     furniture, so an eighth gold badge would have read as one more badge; this has to be findable
     by someone who does not yet know the screen, which is the entire point of it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <gradient
        android:angle="270"
        android:startColor="#2fbf5e"
        android:endColor="#1c8f42"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#66ffffff" />
</shape>
