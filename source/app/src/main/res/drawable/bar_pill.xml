<?xml version="1.0" encoding="utf-8"?>
<!-- Top-bar pill — THABTHABA STORE's bg_search_pill, copied to the number so the three apps'
     bars read as one product (owner's call, 2026-09-09). Every chip and icon button in the
     Settings toolbar and the picker's top strip wears this: 16dp radius, glass fill, 1dp gold
     hairline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@color/bar_glass" />
    <stroke android:width="1dp" android:color="@color/aurora_border" />
</shape>
