<?xml version="1.0" encoding="utf-8"?>
<!-- Switch thumb. White when on so it reads against the gradient; grey when off.

     The insets are load-bearing, and they are why this is a layer-list rather than a bare oval.
     SwitchCompat draws the thumb at (the thumb's intrinsic WIDTH) x (the switch's full HEIGHT) —
     it never uses the thumb's own height. A 24dp oval in a 30dp track was therefore painted into
     a 24x30 box, which is how a circle became an egg. Padding the oval out to a 30x30 intrinsic
     size makes the drawn box square again, so the visible circle is a real circle.

     The 3dp inset x2 + 24dp = 30dp must stay equal to the track height in switch_track.xml. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <layer-list>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <size android:width="24dp" android:height="24dp" />
                    <solid android:color="#ffffff" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <size android:width="24dp" android:height="24dp" />
                    <solid android:color="#8b95a5" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
